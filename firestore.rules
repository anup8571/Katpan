rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidSeat(seat) {
      return seat is string && seat.size() == 1 && seat in ['A', 'B', 'C', 'D', 'E', 'F'];
    }

    // 3. Entity Validation Blueprint: UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'playerId',
          'displayName',
          'email',
          'preferredSeat',
          'coins',
          'highestBalance',
          'totalWins',
          'totalRounds',
          'emailVerified',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'playerId',
          'displayName',
          'email',
          'preferredSeat',
          'coins',
          'highestBalance',
          'totalWins',
          'totalRounds',
          'emailVerified',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.playerId is string
        && data.playerId.size() >= 3
        && data.playerId.size() <= 32
        && data.playerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 64
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 128
        && isValidSeat(data.preferredSeat)
        && data.coins is int
        && data.coins >= 0
        && data.coins <= 1000000000
        && data.highestBalance is int
        && data.highestBalance >= 0
        && data.highestBalance <= 1000000000
        && data.totalWins is int
        && data.totalWins >= 0
        && data.totalWins <= 10000000
        && data.totalRounds is int
        && data.totalRounds >= 0
        && data.totalRounds <= 10000000
        && data.emailVerified is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Collection Rules: /users/{userId}
    // PII Isolation: Contains email, so read/write restricted strictly to owner
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().playerId == existing().playerId
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Update profile preferences or stats
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'preferredSeat',
            'coins',
            'highestBalance',
            'totalWins',
            'totalRounds',
            'emailVerified',
            'updatedAt'
          ])
        );

      allow delete: if false;
    }
  }
}
